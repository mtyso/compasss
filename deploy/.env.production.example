# .env Компаса на AHost (docs/DEPLOY.md, шаг 5). Файл живёт только на сервере: chmod 600 .env, не в чат и не в репозиторий.
# Пустые строки с паролями и токенами заполняются руками на сервере.

APP_NAME=Kompas
APP_ENV=production
# APP_KEY создаёт команда php artisan key:generate --force (только при первой установке)
APP_KEY=
APP_DEBUG=false
# адрес поддомена с https, без / в конце
APP_URL=https://kompas.example.uz

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# журнал по дням, 14 дней: диск общий на все сайты
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# база и пользователь из cPanel → MySQL Databases (у AHost имена с префиксом аккаунта, например user_kompas)
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# сессии, кэш и очередь в базе: на хостинге нет Redis и долгих процессов
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# куда deploy/deploy-git.sh кладёт дамп базы перед миграциями (вне сайта)
BACKUP_PATH=

# Telegram-бот (docs/BOT.md, «Настройка»). Токен от @BotFather вписывается только сюда.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# длинная случайная строка: php -r "echo bin2hex(random_bytes(24));"
TELEGRAM_WEBHOOK_SECRET=
# свой Telegram ID (число), через запятую, если их несколько
ALLOWED_TELEGRAM_IDS=
